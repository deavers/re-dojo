# RE:DOJO - code style for NEW labs only (docs/lab_plan.md). Existing labs are not reformatted.
# Copy this file into each new lab folder; usage: clang-format -i <files of that lab>
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
ColumnLimit: 120
BreakBeforeBraces: Allman
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
PointerAlignment: Left
SortIncludes: Never
